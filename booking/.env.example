# 이 파일을 .env 로 복사한 뒤 실제 값으로 채워주세요.
# .env 파일은 절대 외부에 공개하거나 깃허브에 올리지 마세요.

# 서버 포트
PORT=3000

# Supabase (https://supabase.com 프로젝트 설정 > API 에서 확인)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# 업소 정보 (사이트에 표시됨)
BUSINESS_NAME=별빛민박
BUSINESS_PHONE=010-4056-5304
BUSINESS_ADDRESS=경북 포항시 북구 죽장면 죽장로 2868
# 숙박업 신고증(영업신고증) 상 신고번호 - 하단 푸터에 표시해 신뢰도를 높입니다
BUSINESS_LICENSE_NO=제16-포항-2020-0031호

# 토스페이먼츠 (https://developers.tosspayments.com 에서 발급)
# 비워두면 결제 없이 "가예약(전화 확인)" 방식으로 동작합니다.
# 테스트 키로 먼저 결제 흐름을 검증한 뒤, 실제 운영 시 상점 심사를 받아 라이브 키로 교체하세요.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 예약 확정 메일 발송용 (선택사항, 없으면 메일 발송 기능은 자동으로 꺼집니다)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
